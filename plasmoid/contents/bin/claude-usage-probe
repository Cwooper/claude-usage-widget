#!/usr/bin/env python3
"""Emit Claude Code limit gauges and the week's model mix as JSON, for the Plasma widget.

Prints a single JSON object to stdout. Values are cached so a failed probe
(offline, npm registry down) degrades to the last good reading rather than a
blank widget.
"""

import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

CACHE = os.path.expanduser("~/.cache/claude-usage.json")

# Pinned to a major: an unpinned @latest re-resolves against the npm registry on
# every poll, and a schema change would empty the bar rather than raise.
CCUSAGE = "ccusage@^20"

# ccusage reports every coding CLI it detects; only Claude's tokens count
# against the limit windows the gauges show.
CCUSAGE_AGENT = "claude"

# Each npx call is a node cold start plus a registry round-trip to resolve the
# range, which at a one-minute poll would be 1440 a day. The week's model mix
# moves slowly enough to sample far less often than the gauges.
MODELS_MAX_AGE = 30 * 60

# /usage reports each window's reset time but not its length, and the pace
# marker needs the length to know how far through the window we are.
WINDOW_SECONDS = {"session": 5 * 3600, "week": 7 * 86400}

# Fixed order so the model bar does not reshuffle its segments between polls.
FAMILIES = ("fable", "opus", "sonnet", "haiku")

USAGE_LINE = re.compile(
    r"Current\s+(session|week)\s*(?:\(([^)]*)\))?\s*:\s*"
    r"(\d+)%\s*used.*?resets\s+"
    r"([A-Za-z]{3}\s+\d{1,2},\s*\d{1,2}(?::\d{2})?\s*[apAP][mM])"
    r"\s*\(([^)]+)\)"
)


def probe_env():
    """plasmashell inherits a thin PATH; claude and npx live outside it."""
    env = dict(os.environ)
    extra = [os.path.expanduser("~/.local/bin"), "/usr/local/bin", "/usr/bin"]
    parts = env.get("PATH", "").split(os.pathsep)
    env["PATH"] = os.pathsep.join(extra + [p for p in parts if p not in extra])
    return env


def run(argv, timeout=60):
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=True,
            # A first-run `claude` prompts on stdin and would otherwise block
            # until the timeout on every poll.
            stdin=subprocess.DEVNULL,
            env=probe_env(),
        )
    except subprocess.CalledProcessError as exc:
        # CalledProcessError only reports the exit status; the reason a user
        # needs ("not logged in", "command not found") is in stderr.
        detail = (exc.stderr or "").strip().splitlines()
        raise RuntimeError("%s: %s" % (
            argv[0], detail[-1][:200] if detail else "exit status %d" % exc.returncode))
    return proc.stdout


def parse_reset(stamp, tzname, now=None):
    """'Aug 17, 12:20am' + 'Atlantic/Reykjavik' -> epoch seconds."""
    try:
        tz = ZoneInfo(tzname)
    except Exception as exc:
        # Falling back to local time would shift every countdown by the offset
        # while still looking healthy; fail loudly so main() records it instead.
        raise ValueError("unusable timezone %r: %s" % (tzname, exc))
    if now is None:
        now = datetime.now(tz)
    elif now.tzinfo is None:
        now = now.replace(tzinfo=tz)
    norm = re.sub(r"\s+", " ", stamp.strip())
    # The stamp carries no year. Supply it rather than letting strptime default,
    # which is deprecated and mishandles Feb 29; a Dec -> Jan reset then lands in
    # the past and gets rolled forward.
    for year in (now.year, now.year + 1):
        dated = re.sub(r"^([A-Za-z]{3} \d{1,2}),", r"\1 %d," % year, norm)
        for fmt in ("%b %d %Y, %I:%M%p", "%b %d %Y, %I%p"):
            try:
                dt = datetime.strptime(dated, fmt).replace(tzinfo=tz)
            except ValueError:
                continue
            if dt >= now - timedelta(days=1):
                return dt.timestamp()
    raise ValueError("unparsable reset time: %r" % stamp)


def gauge_key(kind, qualifier):
    if kind == "session":
        return "session"
    if not qualifier or qualifier.lower().startswith("all"):
        return "week"
    return qualifier.strip().lower()


def inactive_session(tzname):
    """Stand-in for the session line /usage omits while no session is open."""
    return {
        "key": "session",
        "pct": 0,
        "resetsAt": None,
        "windowSeconds": WINDOW_SECONDS["session"],
        "tz": tzname,
        "inactive": True,
    }


def parse_usage(text, now=None):
    """Gauge dicts from the text `claude -p /usage` prints."""
    gauges = []
    for kind, qualifier, pct, stamp, tzname in USAGE_LINE.findall(text):
        kind = kind.lower()
        gauges.append(
            {
                "key": gauge_key(kind, qualifier),
                "pct": int(pct),
                "resetsAt": parse_reset(stamp, tzname, now),
                "windowSeconds": WINDOW_SECONDS[kind],
                "tz": tzname,
            }
        )
    if not gauges:
        raise ValueError("no usage lines in /usage output")
    # Between sessions /usage prints the weekly lines and drops the session one
    # entirely. Those weekly lines parsing is what separates that from a format
    # change, which would take the whole block out.
    if not any(g["key"] == "session" for g in gauges):
        gauges.insert(0, inactive_session(gauges[0]["tz"]))
    return gauges


def unexpired(gauges, now):
    """Cached gauges whose window is still open.

    A rolled-over window says nothing about the one now running: its percentage
    belongs to a window that no longer exists, and its countdown reads "now"
    forever. Better to show nothing for it than yesterday's number.
    """
    return [g for g in gauges if g.get("resetsAt") and g["resetsAt"] > now]


def read_gauges():
    return parse_usage(run(["claude", "-p", "/usage"], timeout=90))


def family(model_name):
    for fam in FAMILIES:
        if fam in model_name:
            return fam
    return model_name


def claude_breakdowns(day):
    """The Claude entry's model breakdowns from one --by-agent daily row.

    Rows without an `agents` array predate that flag and are Claude-only.
    """
    agents = day.get("agents")
    if not agents:
        return day.get("modelBreakdowns", [])
    for entry in agents:
        if entry.get("agent") == CCUSAGE_AGENT:
            return entry.get("modelBreakdowns", [])
    return []


def aggregate_models(payload):
    """Collapse ccusage daily buckets into one output-token total per family.

    Output tokens, not totalTokens: cache reads dwarf everything else and would
    make the bar a chart of cache hits rather than of work done.
    """
    mix = {}
    for day in payload.get("daily") or []:
        for entry in claude_breakdowns(day):
            fam = family(entry.get("modelName", ""))
            mix[fam] = mix.get(fam, 0) + entry.get("outputTokens", 0)

    ordered = [f for f in FAMILIES if mix.get(f)]
    ordered += sorted(k for k in mix if k not in FAMILIES and mix[k])
    return [{"name": f, "tokens": mix[f]} for f in ordered]


def read_models(since):
    """Model mix since `since` (a date), to pair with the weekly limit gauge.

    Day-bucketed, so the window's opening day is counted whole even though the
    limit window opens partway through it. ccusage's own weekly buckets are not
    usable here: they roll over at Monday midnight while the limit window rolls
    over mid-morning, which would blank the bar for those hours.
    """
    payload = json.loads(
        run(["npx", "-y", CCUSAGE, "daily", "--json", "--by-agent",
             "--since", since.isoformat()], timeout=120)
    )
    return aggregate_models(payload)


def window_start(gauges, now=None):
    """Date the weekly limit window opened, for scoping the model mix.

    Dated in the timezone /usage reported, not the machine's: far enough east or
    west the two disagree by a day and --since would clip the opening day.
    """
    for gauge in gauges:
        if gauge["windowSeconds"] == WINDOW_SECONDS["week"]:
            opened = gauge["resetsAt"] - gauge["windowSeconds"]
            try:
                tz = ZoneInfo(gauge["tz"])
            except Exception:
                tz = None
            return datetime.fromtimestamp(opened, tz).date()
    if now is None:
        now = datetime.now()
    return (now - timedelta(seconds=WINDOW_SECONDS["week"])).date()


def load_cache():
    try:
        with open(CACHE) as fh:
            return json.load(fh)
    except Exception:
        return {}


def save_cache(payload):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(payload, fh)
        os.replace(tmp, CACHE)
    except Exception:
        pass


def main():
    cached = load_cache()
    result = {"ts": time.time(), "stale": False, "errors": []}

    try:
        result["gauges"] = read_gauges()
        fresh_gauges = result["gauges"]
    except Exception as exc:
        result["gauges"] = unexpired(cached.get("gauges", []), result["ts"])
        # Cached reset times may be days stale, which would scope the model mix
        # to a window that has since rolled over.
        fresh_gauges = []
        result["stale"] = True
        result["errors"].append("gauges: %s" % exc)

    cached_models_age = result["ts"] - cached.get("modelsTs", 0)
    if cached.get("models") and cached_models_age < MODELS_MAX_AGE:
        result["models"] = cached["models"]
        result["modelsTs"] = cached["modelsTs"]
    else:
        try:
            result["models"] = read_models(window_start(fresh_gauges))
            result["modelsTs"] = result["ts"]
        except Exception as exc:
            result["models"] = cached.get("models", [])
            result["modelsTs"] = cached.get("modelsTs", 0)
            result["stale"] = True
            result["errors"].append("models: %s" % exc)

    result["ok"] = bool(result["gauges"])
    save_cache(result)
    json.dump(result, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
